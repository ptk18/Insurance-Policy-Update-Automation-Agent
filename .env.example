# Copy to .env (gitignored). The app loads .env explicitly at startup; shell
# variables take precedence over this file. Never commit real keys.
GEMINI_API_KEY=
# Optional override of the default text-extraction model.
# GEMINI_MODEL=gemini-3.8-flash
# DATABASE_URL=postgresql+psycopg://localhost/policy_update
# MAX_ATTACHMENT_BYTES=5242880
# Agent loop (on by default when a key is set). Set off to keep rule-based processing.
# AGENT_LOOP=on
# AGENT_TOOL_BUDGET=12
