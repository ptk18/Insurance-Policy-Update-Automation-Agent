# Copy to .env (gitignored). The app loads .env explicitly at startup; shell
# variables take precedence over this file. Never commit real keys.
GEMINI_API_KEY=
# Optional override for extraction and tool selection.
# GEMINI_MODEL=gemini-3.8-flash
# DATABASE_URL=postgresql+psycopg://localhost/policy_update
# MAX_ATTACHMENT_BYTES=5242880
# Agent loop (on when a key is set). Set off for extraction without tool selection.
# AGENT_LOOP=on
# AGENT_TOOL_BUDGET=12
# Job worker. embedded (default): a worker thread inside the API process.
# external: the API only queues; run `uv run python -m policy_update.worker` alongside.
# WORKER_MODE=embedded
# JOB_LEASE_SECONDS=90   # use 180 for hosted model runs
# WORKER_POLL_SECONDS=1
# MAX_JOB_ATTEMPTS=5

# Public-demo lifecycle and budgets (shared by API and worker).
# Set SCHEMA_MODE=verify for deployments after running the explicit migration.
SCHEMA_MODE=local
GUEST_TTL_SECONDS=604800
MAX_WORKSPACES=2000
MAX_WORKSPACE_CASES=25
MAX_CASE_VERSIONS=50
MAX_CASE_ATTACHMENTS=10
MAX_WORKSPACE_ATTACHMENT_BYTES=26214400
MAX_WORKSPACE_RUNS=50
MAX_DAILY_RUNS=200
